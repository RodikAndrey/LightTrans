{"text": "Добрый день, меня зовут Андрей, я руководитель проекта. Здравствуйте, Андрей, меня зовут Мария, я аналитик данных. Расскажите, пожалуйста, о результатах последнего исследования. Конечно, мы опросили более 1000 клиентов за 3 месяца. И какие основные выводы вы можете сделать? Большинство пользователей довольны скоростью работы приложения. А что говорят про интерфейс и удобство навигации? Здесь есть замечание, люди просят упростить главное меню. Понял. Давайте обсудим это на следующей неделе с дизайнерами. Хорошо, я подготовлю презентацию с цифрами и примерами. Отлично. Тогда жду вас в четверг в 10 часов утра. Договорились. Всего доброго, до свидания.", "timestamps": [0.56, 0.72, 0.88, 1.04, 1.2, 1.44, 1.68, 1.92, 2.08, 2.24, 2.32, 2.4, 2.48, 2.56, 2.64, 2.8000000000000003, 2.96, 3.2, 3.2800000000000002, 3.44, 3.52, 3.68, 3.84, 4.0, 4.16, 4.4, 4.72, 5.5200000000000005, 5.68, 5.92, 6.08, 6.32, 6.32, 6.4, 6.48, 6.5600000000000005, 6.640000000000001, 6.640000000000001, 6.8, 6.88, 7.12, 7.2, 7.36, 7.44, 7.6000000000000005, 7.68, 7.84, 8.0, 8.24, 8.32, 8.4, 8.72, 8.88, 9.040000000000001, 9.36, 9.68, 10.56, 10.64, 10.88, 11.040000000000001, 11.28, 11.44, 11.6, 11.68, 11.84, 11.92, 12.0, 12.16, 12.4, 12.56, 12.8, 12.96, 13.120000000000001, 13.280000000000001, 13.6, 13.76, 13.92, 14.0, 14.16, 14.4, 14.72, 15.92, 16.16, 16.4, 16.56, 16.72, 16.88, 16.96, 17.12, 17.28, 17.52, 17.76, 17.84, 17.84, 17.92, 18.0, 18.16, 18.32, 18.56, 18.72, 18.88, 18.96, 19.12, 19.28, 19.6, 19.92, 20.88, 21.2, 21.36, 21.52, 21.68, 21.92, 22.080000000000002, 22.240000000000002, 22.400000000000002, 22.56, 22.72, 22.88, 23.36, 23.68, 24.0, 24.88, 25.04, 25.2, 25.28, 25.52, 25.68, 25.76, 25.92, 26.080000000000002, 26.16, 26.32, 26.400000000000002, 26.560000000000002, 26.64, 26.88, 26.96, 27.12, 27.28, 27.36, 27.6, 27.76, 28.0, 28.32, 28.64, 29.76, 30.080000000000002, 30.32, 30.400000000000002, 30.560000000000002, 30.64, 30.8, 31.04, 31.12, 31.28, 31.36, 31.52, 31.68, 31.84, 31.92, 32.1600000000